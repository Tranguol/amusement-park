Процедура ОбработкаПроведения(Отказ,Режим)
	

	// регистр АктивныеПосешения
	Движения.АктивныеПосешения.Записывать = Истина;
	Движение = Движения.АктивныеПосешения.Добавить();
	Движение.Период = Дата;
	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	Движение.Основание = Основание;
	Движение.Аттракцион = Аттракцион;
	Движение.КоличествоПосещений = 1;

	Движения.Записать();
	
	Запрос = Новый запрос();
	
	Запрос.Текст = "ВЫБРАТЬ
	|	АктивныеПосешенияОстатки.Основание КАК Основание
	|ИЗ
	|	РегистрНакопления.АктивныеПосешения.Остатки(, Основание = &Основание) КАК АктивныеПосешенияОстатки
	|ГДЕ
	|	АктивныеПосешенияОстатки.КоличествоПосещенийОстаток < 0";
	
	Запрос.УстановитьПараметр("Основание",Основание );
	
	Если Не Запрос.Выполнить().Пустой() Тогда
	Отказ = Истина;
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = "По одному билету можно проходить только один раз";
	Сообщение.УстановитьДанные(ЭтотОбъект);
	Сообщение.Поле = "Основание";
	Сообщение.Сообщить();
	КонецЕсли;	
		
	
КонецПроцедуры

